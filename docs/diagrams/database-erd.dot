digraph erd {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=22, label="personal-baas — Database ER Diagram\n(PostgreSQL, per-schema clusters, platform.projects is the multi-tenancy root)", labelloc=t, labeljust=c, pad=0.4, nodesep=0.35, ranksep=0.9, splines=spline, compound=true];
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, color="#7f8c8d", penwidth=1.1];
  subgraph "cluster_platform" {
    label="platform schema"; style="rounded,filled"; color="#E67E22"; fillcolor="#FCF3E7"; fontname="Helvetica-Bold"; fontsize=14; margin=16;
  "platform_projects" [shape=plain, label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FCF3E7">
<TR><TD COLSPAN="2" BGCOLOR="#E67E22"><FONT COLOR="white"><B>platform.projects</B></FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">uuid</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="slug">slug<FONT POINT-SIZE="9" COLOR="#555555"> uq</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">text</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">text</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="schema_name">schema_name<FONT POINT-SIZE="9" COLOR="#555555"> uq</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">text</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="anon_role">anon_role</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">text</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="authenticated_role">authenticated_role</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">text</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="service_role_role">service_role_role</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">text</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="mfa_required">mfa_required</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bool</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamptz</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamptz</FONT></TD></TR>
</TABLE>>];

  "platform_platform_admins" [shape=plain, label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FCF3E7">
<TR><TD COLSPAN="2" BGCOLOR="#E67E22"><FONT COLOR="white"><B>platform.platform_admins</B></FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">uuid</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="email">email<FONT POINT-SIZE="9" COLOR="#555555"> uq</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">text</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="password_hash">password_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">text</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamptz</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="last_login_at">last_login_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamptz</FONT></TD></TR>
</TABLE>>];

  "platform_admin_sql_history" [shape=plain, label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FCF3E7">
<TR><TD COLSPAN="2" BGCOLOR="#E67E22"><FONT COLOR="white"><B>platform.admin_sql_history</B></FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">uuid</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="admin_id"><I>admin_id</I><FONT POINT-SIZE="9" COLOR="#555555"> fk?</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">uuid</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="admin_email">admin_email</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">text</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="mode">mode</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">text</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="sql">sql</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">text</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="success">success</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bool</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="statement_count">statement_count</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="duration_ms">duration_ms</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="executed_at">executed_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamptz</FONT></TD></TR>
</TABLE>>];

  "platform_api_keys" [shape=plain, label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FCF3E7">
<TR><TD COLSPAN="2" BGCOLOR="#E67E22"><FONT COLOR="white"><B>platform.api_keys</B></FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="id"><B><U>id</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">uuid</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="project_id"><I>project_id</I><FONT POINT-SIZE="9" COLOR="#555555"> fk</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">uuid</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">text</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="kind">kind<FONT POINT-SIZE="9" COLOR="#555555"> publishable|secret</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">text</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="created_by">created_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">text</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="revoked_at">revoked_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamptz</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamptz</FONT></TD></TR>
</TABLE>>];

  "platform_settings" [shape=plain, label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FCF3E7">
<TR><TD COLSPAN="2" BGCOLOR="#E67E22"><FONT COLOR="white"><B>platform.settings</B></FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="key"><B><U>key</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">text</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="value">value</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">jsonb</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamptz</FONT></TD></TR>
</TABLE>>];

  }
