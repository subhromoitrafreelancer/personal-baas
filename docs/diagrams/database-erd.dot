<TR><TD ALIGN="LEFT" PORT="password_hash">password_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">text</FONT></TD></TR>
<TR><TD ALIGN="LEFT" PORT="status">status<FONT POINT-SIZE="9" COLOR="#555555"> active|disabled|invited</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">text</FONT></TD></TR>
