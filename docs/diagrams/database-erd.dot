  subgraph "cluster_notes" {
    label="developer-managed (not fixed by migrations)"; style="rounded,dashed"; color="#909497"; fontname="Helvetica-Bold"; fontsize=14; margin=16;
    "api_dev" [shape=box, style="rounded,filled", fillcolor="#F4F6F6", color="#909497", fontsize=11, label="api / api_<slug> schema\n(one per project, exposed via PostgREST)\ntables + RLS policies defined by the developer\nin the SQL console"];
    "private_dev" [shape=box, style="rounded,filled", fillcolor="#F4F6F6", color="#909497", fontsize=11, label="private schema\nbootstrap-only, never exposed via PostgREST"];
  }
