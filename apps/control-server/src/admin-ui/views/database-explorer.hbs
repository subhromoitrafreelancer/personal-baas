<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Database Explorer — Personal BaaS Admin</title>
  <link rel="stylesheet" href="/admin/static/css/admin.css" />
  <link rel="stylesheet" href="/admin/static/css/database-explorer.css" />
</head>
<body>
  {{> topbar}}

  <main class="page db-explorer-page">
    <div class="page-header">
      <div class="page-header-text">
        <h1>Database</h1>
        <p class="page-description">Browse every schema, table, and view PostgREST can see.</p>
      </div>
      <div class="page-header-actions">
        <label class="field">Project <select id="project-select"></select></label>
        <button id="refresh-objects-btn" type="button" class="btn btn-primary" data-icon="refresh">Refresh</button>
      </div>
    </div>
    <div class="db-explorer-toolbar toolbar">
      <span id="objects-status" class="run-status"></span>
    </div>
    <nav id="schema-nav" class="schema-nav" aria-label="Jump to schema"></nav>
    <div id="schemas-container"></div>
  </main>

  <div id="modal-overlay" class="modal-overlay" hidden>
    <div id="modal" class="modal">
      <div class="modal-header">
        <h2 id="modal-title"></h2>
        <button type="button" id="modal-close-btn" class="btn-icon modal-close" data-icon="close" aria-label="Close" title="Close"></button>
      </div>
      <div id="modal-body" class="modal-body"></div>
      <div id="modal-footer" class="modal-footer"></div>
    </div>
  </div>

  {{> footer}}

  <script src="/admin/static/js/icons.js"></script>
  <script src="/admin/static/js/topbar.js"></script>
  <script src="/admin/static/js/clipboard.js"></script>
  <script src="/admin/static/js/project-selector.js"></script>
  <script type="module" src="/admin/static/js/database-explorer.js"></script>
</body>
</html>
