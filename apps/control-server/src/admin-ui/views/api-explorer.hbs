<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>API Explorer — Personal BaaS Admin</title>
  <link rel="stylesheet" href="/admin/static/css/admin.css" />
  <link rel="stylesheet" href="/admin/static/css/api-explorer.css" />
</head>
<body>
  {{> topbar}}

  <main class="page api-explorer-page">
    <div class="page-header">
      <div class="page-header-text">
        <h1>API Explorer</h1>
        <p class="page-description">Copy-paste request snippets for every table, view, and function.</p>
      </div>
      <div class="page-header-actions">
        <label class="field">Project <select id="project-select"></select></label>
        <button id="refresh-api-btn" type="button" class="btn btn-primary" data-icon="refresh">Refresh</button>
        <button id="toggle-openapi-btn" type="button" class="btn btn-outline" data-icon="view">View OpenAPI Spec</button>
      </div>
    </div>
    <div class="api-explorer-toolbar toolbar">
      <span id="api-status" class="run-status"></span>
    </div>
    <div id="api-objects-container"></div>

    <section id="openapi-panel" class="openapi-panel" hidden>
      <div class="openapi-panel-header">
        <h2>PostgREST OpenAPI spec</h2>
        <a id="open-raw-openapi-link" href="#" target="_blank" rel="noopener" data-icon="external-link">Open raw in new tab</a>
        <button id="download-openapi-btn" type="button" class="btn btn-outline btn-sm" data-icon="download">Download JSON</button>
      </div>
      <pre id="openapi-json"></pre>
    </section>
  </main>

  {{> footer}}

  <script src="/admin/static/js/icons.js"></script>
  <script src="/admin/static/js/topbar.js"></script>
  <script src="/admin/static/js/clipboard.js"></script>
  <script src="/admin/static/js/project-selector.js"></script>
  <script type="module" src="/admin/static/js/api-explorer.js"></script>
</body>
</html>
