<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Storage — Personal BaaS Admin</title>
  <link rel="stylesheet" href="/admin/static/css/admin.css" />
  <link rel="stylesheet" href="/admin/static/css/storage.css" />
</head>
<body>
  {{> topbar}}

  <main class="page storage-page">
    <div class="page-header">
      <div class="page-header-text">
        <h1>Storage</h1>
        <p class="page-description">Project-scoped file buckets, backed by a single MinIO instance.</p>
      </div>
      <div class="page-header-actions">
        <label class="field">Project <select id="project-select"></select></label>
      </div>
    </div>

    <div class="storage-layout">
      <section class="card bucket-panel">
        <div class="card-header">
          <h2>Buckets</h2>
        </div>
        <div class="card-body">
          <form id="create-bucket-form" class="inline-form">
            <label class="field">Name <input id="new-bucket-name" type="text" required placeholder="e.g. avatars" /></label>
            <label class="field">Size limit (bytes, optional) <input id="new-bucket-size-limit" type="number" min="1" /></label>
            <label class="field checkbox-field"><input id="new-bucket-public" type="checkbox" /> Public read</label>
            <button type="submit" class="btn btn-primary" data-icon="save">Create</button>
            <button type="button" id="cancel-create-bucket-btn" class="btn btn-outline" data-icon="close">Cancel</button>
          </form>
          <ul id="bucket-list" class="bucket-list"></ul>
        </div>
      </section>

      <section class="card object-panel">
        <div class="card-header">
          <h2 id="object-panel-title">Objects</h2>
          <span id="objects-status" class="run-status"></span>
        </div>
        <div class="card-body">
          <div id="no-bucket-selected" class="banner banner-warning">Select a bucket to browse its objects.</div>

          <form id="upload-form" class="inline-form" hidden>
            <label class="field">File <input id="upload-file" type="file" required /></label>
            <label class="field">Path <input id="upload-path" type="text" required placeholder="e.g. logo.png" /></label>
            <button type="submit" class="btn btn-primary" data-icon="upload">Upload</button>
          </form>

          <div class="table-wrap">
            <table id="objects-table" class="table objects-table" hidden>
              <thead>
                <tr>
                  <th>Path</th>
                  <th>Size</th>
                  <th>Content type</th>
                  <th>Owner</th>
                  <th>Created</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="objects-tbody"></tbody>
            </table>
          </div>
        </div>
      </section>
    </div>
  </main>

  {{> footer}}

  <script src="/admin/static/js/icons.js"></script>
  <script src="/admin/static/js/toast.js"></script>
  <script src="/admin/static/js/topbar.js"></script>
  <script src="/admin/static/js/project-selector.js"></script>
  <script src="/admin/static/js/storage.js"></script>
</body>
</html>
