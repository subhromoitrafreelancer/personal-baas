<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Users — Personal BaaS Admin</title>
  <link rel="stylesheet" href="/admin/static/css/admin.css" />
  <link rel="stylesheet" href="/admin/static/css/admin-users.css" />
</head>
<body>
  {{> topbar}}

  <main class="page admin-users-page">
    <div class="page-header">
      <div class="page-header-text">
        <h1>Users</h1>
        <p class="page-description">Application end users, scoped to the selected project.</p>
      </div>
      <div class="page-header-actions">
        <label class="field">Project <select id="project-select"></select></label>
        <span id="users-status" class="run-status"></span>
      </div>
    </div>

    <div class="admin-users-toolbar toolbar">
      <input id="search-input" type="search" placeholder="Search by email…" />
      <button id="search-btn" type="button" class="btn btn-outline" data-icon="search">Search</button>
    </div>

    <div id="secret-banner" class="secret-banner" hidden></div>

    <form id="create-user-form" class="inline-form">
      <label class="field">Email <input id="new-user-email" type="email" required /></label>
      <label class="field">Password (optional — leave blank to auto-generate) <input id="new-user-password" type="text" /></label>
      <button type="submit" class="btn btn-primary" data-icon="save">Create</button>
      <button type="button" id="cancel-create-btn" class="btn btn-outline" data-icon="close">Cancel</button>
    </form>

    <div class="table-wrap">
      <table class="table users-table">
        <thead>
          <tr>
            <th>Email</th>
            <th>Status</th>
            <th>Email verified</th>
            <th>Created</th>
            <th>Last sign-in</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="users-tbody"></tbody>
      </table>
    </div>

    <div class="pagination">
      <button id="prev-page-btn" type="button" class="btn btn-outline btn-sm">Previous</button>
      <span id="page-info"></span>
      <button id="next-page-btn" type="button" class="btn btn-outline btn-sm">Next</button>
    </div>
  </main>

  {{> footer}}

  <script src="/admin/static/js/icons.js"></script>
  <script src="/admin/static/js/topbar.js"></script>
  <script src="/admin/static/js/clipboard.js"></script>
  <script src="/admin/static/js/project-selector.js"></script>
  <script src="/admin/static/js/admin-users.js"></script>
</body>
</html>
