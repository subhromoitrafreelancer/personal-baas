<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>API Keys — Personal BaaS Admin</title>
  <link rel="stylesheet" href="/admin/static/css/admin.css" />
</head>
<body>
  {{> topbar}}

  <main class="page api-keys-page">
    <h1>API Keys</h1>
    <div class="api-keys-toolbar toolbar">
      <button id="create-key-btn" type="button" class="btn btn-primary">Create key</button>
      <span id="keys-status" class="run-status"></span>
    </div>

    <div id="secret-banner" class="secret-banner" hidden></div>

    <form id="create-key-form" class="inline-form" hidden>
      <label class="field">Name <input id="new-key-name" type="text" required placeholder="e.g. web-app-publishable" /></label>
      <label class="field">Kind
        <select id="new-key-kind">
          <option value="publishable">Publishable (anon)</option>
          <option value="secret">Secret (service_role — never expose to browsers)</option>
        </select>
      </label>
      <button type="submit" class="btn btn-primary">Create</button>
      <button type="button" id="cancel-create-btn" class="btn btn-outline">Cancel</button>
    </form>

    <div class="table-wrap">
      <table class="table keys-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Kind</th>
            <th>Created</th>
            <th>Created by</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="keys-tbody"></tbody>
      </table>
    </div>
  </main>

  {{> footer}}

  <script src="/admin/static/js/topbar.js"></script>
  <script src="/admin/static/js/api-keys.js"></script>
</body>
</html>
