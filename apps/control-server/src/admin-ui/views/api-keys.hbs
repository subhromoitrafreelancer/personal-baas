<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>API Keys — Personal BaaS Admin</title>
  <link rel="stylesheet" href="/admin/static/css/admin.css" />
</head>
<body>
  {{> topbar}}

  <main class="page api-keys-page">
    <div class="page-header">
      <div class="page-header-text">
        <h1>API Keys</h1>
        <p class="page-description">Publishable keys for browsers, secret keys for trusted servers.</p>
      </div>
      <div class="page-header-actions">
        <label class="field">Project <select id="project-select"></select></label>
        <button id="generate-env-btn" type="button" class="btn btn-outline" data-icon="download">Generate .env</button>
        <span id="keys-status" class="run-status"></span>
      </div>
    </div>

    <div id="secret-banner" class="secret-banner" hidden></div>

    <form id="create-key-form" class="inline-form">
      <label class="field">Name <input id="new-key-name" type="text" required placeholder="e.g. web-app-publishable" /></label>
      <label class="field">Kind
        <select id="new-key-kind">
          <option value="publishable">Publishable (anon)</option>
          <option value="secret">Secret (service_role — never expose to browsers)</option>
        </select>
      </label>
      <button type="submit" class="btn btn-primary" data-icon="save">Create</button>
      <button type="button" id="cancel-create-btn" class="btn btn-outline" data-icon="close">Cancel</button>
    </form>

    <div class="table-wrap">
      <table class="table keys-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Kind</th>
            <th>Created</th>
            <th>Created by</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="keys-tbody"></tbody>
      </table>
    </div>
  </main>

  {{> footer}}

  <script src="/admin/static/js/icons.js"></script>
  <script src="/admin/static/js/topbar.js"></script>
  <script src="/admin/static/js/clipboard.js"></script>
  <script src="/admin/static/js/project-selector.js"></script>
  <script src="/admin/static/js/api-keys.js"></script>
</body>
</html>
