<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>SQL Editor — Personal BaaS Admin</title>
  <link rel="stylesheet" href="/admin/static/css/admin.css" />
  <link rel="stylesheet" href="/admin/static/css/sql-editor.css" />
</head>
<body>
  {{> topbar}}

  <main class="page sql-editor-page">
    <div class="page-header">
      <div class="page-header-text">
        <h1>SQL Editor</h1>
        <p class="page-description">Run raw SQL against a project's schema.</p>
      </div>
      <div class="page-header-actions">
        <label class="field">Project <select id="project-select"></select></label>
      </div>
    </div>

    <div class="sql-toolbar toolbar">
      <div class="toolbar-group" role="group" aria-label="Run">
        <button id="run-statement-btn" type="button" class="btn btn-primary" data-icon="run" title="Run the statement at the cursor">Run statement</button>
        <button id="run-script-btn" type="button" class="btn btn-primary" data-icon="run" title="Run the entire script">Run script</button>
        <button id="cancel-btn" type="button" class="btn btn-danger" data-icon="close" title="Cancel the running query" hidden>Cancel</button>
      </div>

      <div class="toolbar-divider" aria-hidden="true"></div>

      <div class="toolbar-group" role="group" aria-label="Query options">
        <label class="row-limit-label" title="Maximum rows returned per statement">
          Row limit
          <input id="row-limit-input" type="number" min="1" max="5000" value="500" />
        </label>
        <label class="snippet-label">
          <select id="snippet-select" title="Insert a snippet">
            <option value="">Insert a snippet…</option>
            <optgroup label="RLS">
              <option value="owner-only">Owner-only access</option>
              <option value="public-read-auth-write">Public read / authenticated write</option>
              <option value="admin-only">Admin-only (service_role)</option>
              <option value="authenticated-crud">Authenticated CRUD (no ownership)</option>
            </optgroup>
            <optgroup label="Realtime">
              <option value="realtime-notify-trigger">Attach change-notify trigger</option>
            </optgroup>
          </select>
        </label>
        <label class="upload-label">
          <input id="sql-file-input" type="file" accept=".sql,text/plain" hidden />
          <button id="upload-btn" type="button" class="btn btn-outline btn-icon" data-icon="upload" aria-label="Upload .sql file" title="Upload .sql file"></button>
        </label>
      </div>

      <div class="toolbar-divider" aria-hidden="true"></div>

      <div class="toolbar-group" role="group" aria-label="History">
        <button id="toggle-history-btn" type="button" class="btn btn-outline btn-icon" data-icon="history" aria-label="Execution history" title="Execution history"></button>
      </div>

      <span id="run-status" class="run-status"></span>
    </div>

    <div class="sql-editor-layout">
      <div class="sql-editor-main">
        <div id="sql-editor-cm" class="sql-editor-cm"></div>

        <div id="sql-error" class="banner banner-danger" hidden></div>

        <div id="sql-results"></div>
      </div>

      <aside id="history-panel" class="history-panel" hidden>
        <div class="history-panel-header">
          <h2>Execution history</h2>
          <button id="refresh-history-btn" type="button" class="btn btn-outline btn-sm" data-icon="refresh">Refresh</button>
        </div>
        <ul id="history-list" class="history-list"></ul>
      </aside>
    </div>
  </main>

  {{> footer}}

  <script src="/admin/static/js/icons.js"></script>
  <script src="/admin/static/js/topbar.js"></script>
  <script src="/admin/static/js/clipboard.js"></script>
  <script src="/admin/static/js/project-selector.js"></script>
  <script type="module" src="/admin/static/js/sql-editor.js"></script>
</body>
</html>
