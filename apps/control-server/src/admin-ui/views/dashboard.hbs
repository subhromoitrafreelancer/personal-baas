<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Dashboard — Personal BaaS Admin</title>
  <link rel="stylesheet" href="/admin/static/css/admin.css" />
  <link rel="stylesheet" href="/admin/static/css/dashboard.css" />
</head>
<body>
  {{> topbar}}

  <main class="page dashboard-page">
    <div class="page-header">
      <div class="page-header-text">
        <h1>Dashboard</h1>
        <p class="page-description">At-a-glance health across every project on this instance.</p>
      </div>
    </div>

    <h2>Projects</h2>
    <div id="projects-table-wrap" class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Project</th>
            <th>Tables</th>
            <th>Users</th>
            <th>API keys</th>
            <th>Warnings</th>
          </tr>
        </thead>
        <tbody id="projects-table-body">
          <tr><td colspan="5">Loading…</td></tr>
        </tbody>
      </table>
    </div>

    <h2>Storage</h2>
    <div id="storage-kpi-grid" class="kpi-grid">
      <div class="kpi-card skeleton"></div>
    </div>

    <h2>Other</h2>
    <div id="kpi-grid" class="kpi-grid">
      <div class="kpi-card skeleton"></div>
    </div>
  </main>

  {{> footer}}

  <script src="/admin/static/js/icons.js"></script>
  <script src="/admin/static/js/topbar.js"></script>
  <script src="/admin/static/js/clipboard.js"></script>
  <script type="module" src="/admin/static/js/dashboard.js"></script>
</body>
</html>
