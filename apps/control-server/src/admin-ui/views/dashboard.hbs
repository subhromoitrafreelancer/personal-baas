<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  {{> theme_init}}
  <title>Dashboard — Personal BaaS Admin</title>
  <link rel="stylesheet" href="/admin/static/css/admin.css" />
  <link rel="stylesheet" href="/admin/static/css/dashboard.css" />
</head>
<body>
  {{> topbar}}

  <main class="page dashboard-page">
    <div class="page-header">
      <div class="page-header-text">
        <h1>Dashboard</h1>
        <p class="page-description">At-a-glance health across every project on this instance.</p>
      </div>
    </div>

    <h2>Project channels</h2>
    <div id="projects-table-wrap" class="table-wrap channel-bank">
      <table class="table channel-table">
        <thead>
          <tr>
            <th>Project</th>
            <th>Tables</th>
            <th>Users</th>
            <th>API keys</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody id="projects-table-body">
          <tr><td colspan="5">Loading…</td></tr>
        </tbody>
      </table>
    </div>

    <h2>Instance readouts</h2>
    <div class="instrument-strip">
      <div id="storage-readouts" class="instrument-group">
        <div class="instrument-cell skeleton"></div>
      </div>
      <div id="other-readouts" class="instrument-group">
        <div class="instrument-cell skeleton"></div>
      </div>
    </div>
  </main>

  {{> footer}}

  <script src="/admin/static/js/icons.js"></script>
  <script src="/admin/static/js/toast.js"></script>
  <script src="/admin/static/js/topbar.js"></script>
  <script src="/admin/static/js/clipboard.js"></script>
  <script type="module" src="/admin/static/js/dashboard.js"></script>
</body>
</html>
