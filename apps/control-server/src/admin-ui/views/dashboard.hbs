<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Admin Console — Personal BaaS</title>
  <link rel="stylesheet" href="/admin/static/css/admin.css" />
</head>
<body>
  <header class="topbar">
    <span class="brand">Personal BaaS Admin</span>
    <nav class="topnav">
      <a href="/admin">Dashboard</a>
      <a href="/admin/sql">SQL Editor</a>
      <a href="/admin/database">Database</a>
      <a href="/admin/api">API Explorer</a>
      <a href="/admin/users">Users</a>
    </nav>
    <form method="post" action="/admin/logout" class="logout-form">
      <span class="signed-in-as">{{email}}</span>
      <button type="submit">Sign out</button>
    </form>
  </header>
  <main class="dashboard">
    <h1>Dashboard</h1>
  </main>
</body>
</html>
