<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Audit Log — Personal BaaS Admin</title>
  <link rel="stylesheet" href="/admin/static/css/admin.css" />
  <link rel="stylesheet" href="/admin/static/css/audit.css" />
</head>
<body>
  {{> topbar}}

  <main class="page audit-page">
    <div class="page-header">
      <div class="page-header-text">
        <h1>Audit Log</h1>
        <p class="page-description">Security-relevant admin and auth events, newest first.</p>
      </div>
      <div class="page-header-actions">
        <button id="refresh-audit-btn" type="button" class="btn btn-primary" data-icon="refresh">Refresh</button>
        <span id="audit-status" class="run-status"></span>
      </div>
    </div>

    <div class="table-wrap">
      <table class="table audit-table">
        <thead>
          <tr>
            <th>Time</th>
            <th>Event</th>
            <th>User</th>
            <th>IP</th>
            <th>Metadata</th>
          </tr>
        </thead>
        <tbody id="audit-tbody"></tbody>
      </table>
    </div>

    <div class="pagination">
      <button id="prev-page-btn" type="button" class="btn btn-outline btn-sm">Previous</button>
      <span id="page-info"></span>
      <button id="next-page-btn" type="button" class="btn btn-outline btn-sm">Next</button>
    </div>
  </main>

  {{> footer}}

  <script src="/admin/static/js/icons.js"></script>
  <script src="/admin/static/js/toast.js"></script>
  <script src="/admin/static/js/topbar.js"></script>
  <script src="/admin/static/js/clipboard.js"></script>
  <script src="/admin/static/js/audit.js"></script>
</body>
</html>
