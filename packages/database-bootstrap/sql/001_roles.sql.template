-- Platform roles (scope.md §9). Run once at container init by
-- infrastructure/postgres/init/00-bootstrap.sh, which substitutes the password
-- placeholders from environment variables. Never committed with real credentials.

do $$
begin
  if not exists (select from pg_roles where rolname = 'baas_admin') then
    -- bypassrls: Postgres only lets a role create another role WITH BYPASSRLS if it has
    -- that attribute itself. Phase 9 (scope.md §23) has baas_admin create each project's
    -- service_role_<slug> (NOLOGIN BYPASSRLS), so baas_admin needs it too. This doesn't
    -- meaningfully change baas_admin's trust level: the SQL console already gives the
    -- single platform admin unrestricted SQL as this role, RLS or not.
    create role baas_admin with login password '${BAAS_ADMIN_PASSWORD}' createrole createdb bypassrls;
  end if;

  if not exists (select from pg_roles where rolname = 'authenticator') then
    -- Login role used by PostgREST; switches request context to anon/authenticated/service_role.
    create role authenticator with login noinherit password '${AUTHENTICATOR_PASSWORD}';
  end if;

  if not exists (select from pg_roles where rolname = 'anon') then
    create role anon nologin;
  end if;

  if not exists (select from pg_roles where rolname = 'authenticated') then
    create role authenticated nologin;
  end if;

  if not exists (select from pg_roles where rolname = 'service_role') then
    create role service_role nologin bypassrls;
  end if;
end
$$;

grant anon to authenticator;
grant authenticated to authenticator;
grant service_role to authenticator;

-- Security remediation (Phase 25, scope.md §39): RealtimeService's per-subscriber RLS re-check
-- needs to SET ROLE to a subscriber's own project role from its baas_admin-authenticated pool
-- connection. baas_admin gets this automatically for every project role it creates itself
-- (provisionAndInsert, PG16 grants the creator ADMIN OPTION), but the default project reuses
-- these three platform-global roles verbatim (scope.md §23) -- they're created above by this
-- same bootstrap script (run as the Postgres superuser), so only the superuser, not baas_admin
-- itself later, can grant them. An existing install upgrading past this point (where this
-- bootstrap script won't re-run) needs the equivalent one-time manual step -- see
-- 1785800000000_grant-project-roles-to-baas-admin.ts's comment.
grant anon to baas_admin;
grant authenticated to baas_admin;
grant service_role to baas_admin;
