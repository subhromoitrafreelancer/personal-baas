{
  "name": "personal-baas",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted Backend-as-a-Service: Postgres + PostgREST + NestJS control service",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/ats-app"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "dev:control-server": "npm run start:dev --workspace apps/control-server",
    "compose:up": "docker compose --env-file .env -f infrastructure/docker/docker-compose.yml up --build",
    "compose:down": "docker compose --env-file .env -f infrastructure/docker/docker-compose.yml down",
    "migrate:up": "npm run migrate:up --workspace apps/control-server",
    "migrate:down": "npm run migrate:down --workspace apps/control-server",
    "migrate:create": "npm run migrate:create --workspace apps/control-server"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  }
}
