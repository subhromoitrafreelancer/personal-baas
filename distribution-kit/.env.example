# Copy to .env and fill in real secrets before running `docker compose up`.
# Generate passwords with e.g. `openssl rand -hex 24` (hex-only — the Postgres bootstrap
# script substitutes these with `sed`, so avoid `/`, `&` or `\` characters).

# --- Images ---
# Tags of the locally-built (or pulled) personal-baas images. Only these three are built by
# you; everything else is pulled from Docker Hub (see docker-compose.personal-baas.yml).
BAAS_CONTROL_SERVER_IMAGE=personal-baas-control-server:0.1.0
BAAS_FUNCTION_RUNNER_IMAGE=personal-baas-function-runner:0.1.0
BAAS_POSTGRES_IMAGE=personal-baas-postgres:0.1.0
# Shared Docker network name for your app services to join. Only change this if the default
# collides with an existing network on your machine.
BAAS_NETWORK_NAME=baas-net

# --- Postgres superuser (container bootstrap only; never used by the app) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_superuser
POSTGRES_DB=personal_baas

# --- Platform roles, created once at container init ---
BAAS_ADMIN_PASSWORD=change_me_baas_admin
AUTHENTICATOR_PASSWORD=change_me_authenticator

# --- control-server ---
NODE_ENV=development
LOG_LEVEL=info

# Signs the admin console's session cookie. Generate with `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=change_me_admin_session_secret_min_32_chars

# Used once on first boot to create the initial platform administrator (admin console login).
# Safe to leave unset/blank after the first admin exists.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change_me_initial_admin_password

# Ed25519 keypair signing application-user access tokens. Generate with
# `node scripts/generate-jwt-keys.mjs` and paste all three lines below.
# AUTH_JWT_PUBLIC_KEY_JWK is the same public key in JWK form — PostgREST's PGRST_JWT_SECRET
# (see docker-compose.personal-baas.yml) needs a JWK, not a PEM, to verify Ed25519-signed tokens.
AUTH_JWT_PRIVATE_KEY_BASE64=change_me_run_generate_jwt_keys
AUTH_JWT_PUBLIC_KEY_BASE64=change_me_run_generate_jwt_keys
AUTH_JWT_PUBLIC_KEY_JWK=change_me_run_generate_jwt_keys
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30

# --- MinIO object storage ---
# Never exposed to browsers/clients — only control-server holds these, over the docker network.
# MINIO_ROOT_PASSWORD must be at least 8 characters.
MINIO_ROOT_USER=change_me_minio_root_user
MINIO_ROOT_PASSWORD=change_me_minio_root_password
# The single real MinIO bucket for the whole deployment — developer-facing logical "buckets"
# are key prefixes within this one bucket, tracked in storage.buckets.
MINIO_BUCKET=baas-storage

# --- TLS (Caddy) ---
# Leave unset for local/dev use: Caddy serves HTTPS on :443 using its own internally-trusted CA
# (browsers show a one-time trust warning for "localhost"). Set to a real, DNS-resolvable domain
# with ports 80+443 reachable from the internet to get automatic, auto-renewing Let's Encrypt
# HTTPS instead — no other config changes needed.
PUBLIC_DOMAIN=localhost
