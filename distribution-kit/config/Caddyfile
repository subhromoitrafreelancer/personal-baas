# Single public entry point. Routes, shared by both the plain-HTTP (:8000, dev convenience)
# and HTTPS (:443, Let's Encrypt) entry points below:
#   /             -> control-server (public landing page)
#   /rest/v1/*    -> PostgREST (prefix stripped; PostgREST itself has no /rest/v1 prefix)
#   /auth/*       -> control-server (application auth API)
#   /storage/v1/* -> control-server (object storage API)
#   /sites/*      -> control-server (static site hosting, public)
#   /functions/*  -> control-server (Functions invocation, public)
#   /realtime/*   -> control-server (WebSocket gateway, upgrade handled transparently)
#   /admin/*      -> control-server (admin API + admin UI pages)
#   /health*      -> control-server (liveness/readiness, also used by container healthchecks)
{
	admin off
}

(routes) {
	encode gzip

	# Exact root only ("handle /" matches "/" exactly, not every path) — everything else falls
	# through to the more specific handlers below, or the catch-all 404 at the bottom.
	handle / {
		reverse_proxy control-server:3000
	}

	handle /rest/v1/* {
		uri strip_prefix /rest/v1
		reverse_proxy postgrest:3001
	}

	handle /auth/* {
		reverse_proxy control-server:3000
	}

	handle /storage/* {
		reverse_proxy control-server:3000
	}

	# Public static site hosting — path-based, same-origin with the routes above, which is what
	# lets a deployed site call /rest/v1/*, /auth/v1/*, /storage/v1/* with no CORS configuration.
	handle /sites/* {
		reverse_proxy control-server:3000
	}

	# Functions — always routes to control-server, never directly to the function-runner sibling
	# process, which has no public route of its own at all (internal docker-network only).
	handle /functions/* {
		reverse_proxy control-server:3000
	}

	# No uri strip_prefix here (unlike /rest/v1) — the WebSocket gateway's own path is literally
	# /realtime/v1, so the request must reach control-server unmodified. reverse_proxy forwards
	# the Connection: Upgrade/Upgrade: websocket handshake automatically, no extra directive.
	handle /realtime/* {
		reverse_proxy control-server:3000
	}

	@admin path /admin /admin/*
	handle @admin {
		reverse_proxy control-server:3000
	}

	handle /health* {
		reverse_proxy control-server:3000
	}

	handle {
		respond "personal-baas: unknown route" 404
	}
}

:8000 {
	import routes
}

# HTTPS entry point. PUBLIC_DOMAIN defaults to "localhost", which Caddy recognizes as not a
# publicly-resolvable domain and automatically serves using its internally-trusted CA — HTTPS
# works out of the box with no config and no internet dependency (browsers will show a one-time
# trust prompt/warning for the self-signed cert). Set PUBLIC_DOMAIN to a real, DNS-resolvable
# domain (with ports 80+443 reachable from the internet) to get a real, auto-renewing Let's
# Encrypt certificate instead — same site block, no other changes needed. To bring your own
# cert/key instead of either mode, replace this block's address line with a `tls <cert> <key>`
# directive pointing at files mounted into the container (see README's TLS section).
{$PUBLIC_DOMAIN:localhost}:443 {
	import routes
}
