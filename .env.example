# Copy to .env and fill in real secrets before running `docker compose up`.
# Generate passwords with e.g. `openssl rand -hex 24` (hex-only — the Postgres bootstrap
# script substitutes these with `sed`, so avoid `/`, `&` or `\` characters).

# --- Postgres superuser (container bootstrap only; never used by the app) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_superuser
POSTGRES_DB=personal_baas
# Host-side port the postgres container's 5432 is published on. Change this if 5433 is also
# already taken on your machine (default 5432 is deliberately avoided to reduce collisions
# with a locally-installed Postgres).
POSTGRES_HOST_PORT=5433

# --- Platform roles (scope.md §9), created once at container init ---
BAAS_ADMIN_PASSWORD=change_me_baas_admin
AUTHENTICATOR_PASSWORD=change_me_authenticator

# --- control-server ---
NODE_ENV=development
LOG_LEVEL=info

# Signs the admin console's session cookie. Generate with `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=change_me_admin_session_secret_min_32_chars

# Used once on first boot to create the initial platform administrator (admin console login).
# Safe to leave unset/blank after the first admin exists.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change_me_initial_admin_password
