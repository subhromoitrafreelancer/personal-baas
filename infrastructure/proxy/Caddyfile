# Single public entry point (scope.md §13). Routes, shared by both the plain-HTTP (:8000, dev
# convenience) and HTTPS (:443, Phase 6 #1 TLS) entry points below:
#   /             -> control-server (public landing page)
#   /rest/v1/*    -> PostgREST (prefix stripped; PostgREST itself has no /rest/v1 prefix)
#   /auth/*       -> control-server (application auth API)
#   /storage/v1/* -> control-server (Phase 7 object storage API)
#   /functions/*  -> control-server (Phase 12 Functions invocation, public)
#   /realtime/*   -> control-server (Phase 8 WebSocket gateway, upgrade handled transparently)
#   /users/*      -> control-server (Phase 22 service-role project user directory)
#   /openapi.json -> control-server (Phase 24 public integration API OpenAPI spec)
#   /admin/*      -> control-server (admin API + admin UI pages)
#   /health*      -> control-server (liveness/readiness, also used by container healthchecks)
#
# Static site hosting (Phase 11, scope.md §25; moved to its own origin in Phase 25's security
# remediation, scope.md §39) is deliberately NOT in this shared block — see the sites-routes
# snippet and its own site blocks below, on a separate `sites.<domain>` host.
{
	admin off
}

(routes) {
	encode gzip

	# Exact root only ("handle /" matches "/" exactly, not every path) — everything else falls
	# through to the more specific handlers below, or the catch-all 404 at the bottom.
	handle / {
		reverse_proxy control-server:3000
	}

	handle /rest/v1/* {
		uri strip_prefix /rest/v1
		reverse_proxy postgrest:3001
	}

	handle /auth/* {
		reverse_proxy control-server:3000
	}

	handle /storage/* {
		reverse_proxy control-server:3000
	}

	# Functions (Phase 12, scope.md §26) -- always routes to control-server, never directly to
	# the function-runner sibling process, which has no public route of its own at all (internal
	# docker-network only, same shape as minio/postgrest).
	handle /functions/* {
		reverse_proxy control-server:3000
	}

	# No uri strip_prefix here (unlike /rest/v1) — the WebSocket gateway's own path is literally
	# /realtime/v1, so the request must reach control-server unmodified. reverse_proxy forwards
	# the Connection: Upgrade/Upgrade: websocket handshake automatically, no extra directive.
	handle /realtime/* {
		reverse_proxy control-server:3000
	}

	# Service-role project user directory (Phase 22, scope.md §36) -- server-to-server read only,
	# guarded by ServiceRoleBearerGuard; no browser/publishable-key traffic ever hits this.
	handle /users/* {
		reverse_proxy control-server:3000
	}

	# Public integration API OpenAPI spec (Phase 24, scope.md §38) -- unauthenticated, mirroring
	# PostgREST's own public openapi.json. A root-level path, not a /prefix/* -- needs its own
	# explicit handle or it falls through to the 404 catch-all below.
	handle /openapi.json {
		reverse_proxy control-server:3000
	}

	@admin path /admin /admin/*
	handle @admin {
		reverse_proxy control-server:3000
	}

	handle /health* {
		reverse_proxy control-server:3000
	}

	handle {
		respond "personal-baas: unknown route" 404
	}
}

# Static site hosting (Phase 11, scope.md §25), deliberately on its own host (Phase 25, scope.md
# §39 -- a security-audit fix). A deployed site's HTML/JS is tenant-controlled, not
# platform-controlled, so it must never share an origin with /admin/* -- same-origin JS can read
# and act on anything /admin/* can (including issuing authenticated fetches with the admin's own
# session cookie attached), which defeats sameOriginGuard's CSRF check entirely, no matter how
# that JS got there. Putting sites on a distinct origin (not just a distinct path) means a
# deployed site's own same-origin fetch()/XHR calls are genuinely cross-origin from /admin/*'s
# perspective, and same-origin only with respect to this platform's own public API surface
# (/rest/v1/*, /auth/v1/*, /storage/v1/*, /functions/v1/*) via CORS -- PostgREST defaults to
# permissive CORS and control-server's own /auth, /storage, /functions already set
# `cors({ origin: true })` (main.ts), so no CORS configuration change was needed for this split.
(sites-routes) {
	encode gzip
	handle {
		reverse_proxy control-server:3000
	}
}

:8000 {
	import routes
}

# ".localhost" is a reserved, non-delegable TLD (RFC 6761) with no real public-suffix entry, so
# it fails the same public-DNS-eligibility check "localhost" itself fails below -- Caddy issues
# this an internally-trusted cert automatically too, same no-internet-dependency behavior, no
# extra config needed for the default PUBLIC_DOMAIN=localhost dev case.
sites.{$PUBLIC_DOMAIN:localhost}:8000 {
	import sites-routes
}

# HTTPS entry point. PUBLIC_DOMAIN defaults to "localhost", which Caddy recognizes as not a
# publicly-resolvable domain and automatically serves using its internally-trusted CA — HTTPS
# works out of the box with no config and no internet dependency (browsers will show a one-time
# trust prompt/warning for the self-signed cert). Set PUBLIC_DOMAIN to a real, DNS-resolvable
# domain (with ports 80+443 reachable from the internet) to get a real, auto-renewing Let's
# Encrypt certificate instead — same site block, no other changes needed. To bring your own
# cert/key instead of either mode, replace this block's address line with a `tls <cert> <key>`
# directive pointing at files mounted into the container (see README's TLS section).
{$PUBLIC_DOMAIN:localhost}:443 {
	import routes
}

# Real-deployment counterpart of the sites.*:8000 block above -- requires one extra DNS record
# (sites.<PUBLIC_DOMAIN> -> this same host) beyond the main domain's own; Caddy then auto-issues
# this hostname its own Let's Encrypt certificate via the same HTTP-01/on-demand flow as the main
# domain, no wildcard cert required.
sites.{$PUBLIC_DOMAIN:localhost}:443 {
	import sites-routes
}
